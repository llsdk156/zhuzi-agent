# 朱子文化特色智能体配置示例

# 服务端口与主机
HOST=0.0.0.0
PORT=8000

# 大模型接口配置（可选：若配置则启用云端大模型推理，若未配置则启用智能体理学知识引擎本地生成模式）
LLM_PROVIDER=gemini  # 可选: gemini, openai, deepseek, qwen, local
API_KEY=
API_BASE_URL=

# 超新星/超星平台接入密钥（可选，用于 Webhook 鉴权）
SUPERNOVA_ACCESS_TOKEN=zhuzi_secret_key_2026

# 系统名称
APP_NAME=考亭理学书院·朱子文化特色智能体

