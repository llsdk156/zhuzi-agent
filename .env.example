# 朱子文化特色智能体配置示例（复制为 .env 后填入实际配置）

# 服务端口与主机
HOST=0.0.0.0
PORT=8000

# 大模型接口配置（优先读取环境变量与 .env；未配置时自动降级为考亭书院本地认知引擎）
# 兼容 OpenAI 协议接口，默认适配智谱清言 GLM 免费模型
API_KEY=
ZHIPU_API_KEY=
API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
VISION_MODEL=glm-4v-flash

# 超新星/超星平台接入密钥（Webhook 鉴权）
SUPERNOVA_ACCESS_TOKEN=zhuzi_secret_key_2026

# 系统名称
APP_NAME=考亭理学书院·朱子文化特色智能体
